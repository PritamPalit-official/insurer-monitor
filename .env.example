# ======================================================================
# Insurer Monitor — Environment Variables
# ======================================================================
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# LLM API key (at least one required for LLM-powered extraction)
GOOGLE_API_KEY=your_google_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# BigQuery (optional — for production warehouse export)
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# BIGQUERY_DATASET=insurer_monitor

# Agent configuration
MAX_STEPS_PER_TABLE=5
COST_CAP_USD=1.00

# Logging
LOG_LEVEL=INFO
